{
    "name": "your-vendor/gmae-service",
    "description": "Game management microservice for multiplayer games",
    "type": "project",
    "require": {
        "php": "^8.2",
        "ext-mongodb": "^2.0",
        "ext-curl": "*",
        "mongodb/mongodb": "^2.1",
        "predis/predis": "^2.2",
        "php-amqplib/php-amqplib": "^3.6",
        "firebase/php-jwt": "^6.9",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.9"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "start-worker": "php bin/finish_game_queue.php",
        "test": "phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "audit": {
            "ignore": [
                "PKSA-y2cr-5h3j-g3ys"
            ]
        }
    }
}